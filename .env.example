# Groq — https://console.groq.com
GROQ_API_KEY=

# Postgres connection string (Supabase project or local docker-compose db)
# Supabase: use the pooled "Transaction" connection string from Project Settings > Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse_platform

# Comma-separated origins allowed to call the API. No wildcard in production.
CORS_ORIGINS=http://localhost:3000
