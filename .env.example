# Groq — https://console.groq.com
GROQ_API_KEY=

# HuggingFace — https://huggingface.co/settings/tokens ("Read" scope is enough)
# Used for hosted embedding inference (Recommend product's catalog/query
# vectors) via the Inference API — see src/products/recommend/embeddings.py.
HF_API_KEY=

# Postgres connection string (Neon/Supabase project, or local docker-compose db)
# `neon link` / `npx neon@latest link` writes a live one to .env.local, which
# takes precedence over this file — see src/core/config.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse_platform

# Comma-separated origins allowed to call the API. No wildcard in production.
CORS_ORIGINS=http://localhost:3000
